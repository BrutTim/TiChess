# Copy to .env or export it in your shell. Never commit the real token.
LICHESS_TOKEN=lip_your_token_here

# Optional host port for Docker Compose. Use 8084 when k3d already occupies 8080.
# VIEW_HOST_PORT=8084

# Optional host path containing Syzygy .rtbw/.rtbz files.
# SYZYGY_PATH=/absolute/path/to/tablebases
